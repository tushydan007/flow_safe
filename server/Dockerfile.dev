# Development Dockerfile for Django backend
FROM python:3.11-slim-bookworm

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=core.settings.development

# Set work directory
WORKDIR /app

# Install system dependencies including GDAL
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    python3-gdal \
    libgl1-mesa-glx \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Find GDAL/GEOS library paths and create symlinks in standard location
RUN GDAL_LIB=$(find /usr/lib -name "libgdal.so*" -type f 2>/dev/null | head -1) && \
    GEOS_LIB=$(find /usr/lib -name "libgeos_c.so*" -type f 2>/dev/null | head -1) && \
    if [ -z "$GDAL_LIB" ]; then echo "ERROR: GDAL library not found"; exit 1; fi && \
    if [ -z "$GEOS_LIB" ]; then echo "ERROR: GEOS library not found"; exit 1; fi && \
    GDAL_DIR=/usr/lib/x86_64-linux-gnu && \
    GEOS_DIR=/usr/lib/x86_64-linux-gnu && \
    if [ ! -f "$GDAL_DIR/libgdal.so" ]; then ln -sf "$GDAL_LIB" "$GDAL_DIR/libgdal.so"; fi && \
    if [ ! -f "$GEOS_DIR/libgeos_c.so" ]; then ln -sf "$GEOS_LIB" "$GEOS_DIR/libgeos_c.so"; fi && \
    echo "GDAL library: $GDAL_DIR/libgdal.so -> $GDAL_LIB" && \
    echo "GEOS library: $GEOS_DIR/libgeos_c.so -> $GEOS_LIB"

# Set GDAL environment variables
ENV CPLUS_INCLUDE_PATH=/usr/include/gdal
ENV C_INCLUDE_PATH=/usr/include/gdal
# Use standard paths (symlinks created above)
ENV GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
ENV GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so

# Install pip and pipenv
RUN pip install --upgrade pip pipenv

# Copy Pipfile
COPY Pipfile Pipfile.lock ./

# Install Python dependencies
RUN pipenv install --dev --system --deploy

# Copy project
COPY . .

# Create necessary directories
RUN mkdir -p /app/media /app/staticfiles /app/logs

# Create non-root user
RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Run development server
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]

